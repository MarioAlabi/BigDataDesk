def resolve_video_dir() -> str:
    """Resolve user's Fondos video directory across Spanish/English/other XDG locales."""
    home = os.path.expanduser("~")
    es_dir = os.path.join(home, "Vídeos", "Fondos")
    try:
        res = subprocess.run(["xdg-user-dir", "VIDEOS"], capture_output=True, text=True)
        xdg_videos = res.stdout.strip()
    except OSError:
        xdg_videos = ""

    if xdg_videos and os.path.abspath(xdg_videos) != os.path.abspath(home):
        candidate = os.path.join(xdg_videos, "Fondos")
        if os.path.isdir(candidate) or not os.path.isdir(es_dir):
            return candidate
    if os.path.isdir(es_dir):
        return es_dir
    return os.path.join(home, "Videos", "Fondos")


