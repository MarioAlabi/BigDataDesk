def list_videos(vertical: bool = False) -> list[str]:
    folder = VIDEO_VERT_DIR if vertical else VIDEO_DIR
    if not os.path.isdir(folder):
        return []
    files: list[str] = []
    for entry in os.scandir(folder):
        if entry.is_file() and entry.name.lower().endswith(VIDEO_EXTENSIONS):
            files.append(entry.path)
    return sorted(files)


def list_static_wallpapers(vertical: bool = False) -> list[str]:
    folder = STATIC_VERT_DIR if vertical else STATIC_DIR
    if not os.path.isdir(folder):
        return []
    vert_prefix = os.path.abspath(STATIC_VERT_DIR) + os.sep
    files: list[str] = []
    for root_dir, _dirs, filenames in os.walk(folder):
        if not vertical and (os.path.abspath(root_dir) + os.sep).startswith(vert_prefix):
            continue
        for name in filenames:
            if name.lower().endswith(STATIC_EXTENSIONS):
                files.append(os.path.join(root_dir, name))
    return sorted(files)


def query_screens() -> list[dict[str, object]]:
    js = """
var ds = desktops();
var seen = {};
var out = [];
for (var i = 0; i < ds.length; i++) {
    var s = ds[i].screen;
    if (s < 0 || s >= screenCount || seen[s]) continue;
    seen[s] = true;
    var g = screenGeometry(s);
    out.push({
        screen: s,
        width: g.width,
        height: g.height,
        vertical: g.height > g.width,
        plugin: ds[i].wallpaperPlugin
    });
}
out.sort(function(a, b) { return a.screen - b.screen; });
print(JSON.stringify(out));
"""
    raw = run([qdbus_bin(), "org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell.evaluateScript", js])
    try:
        parsed = json.loads(raw)
        if isinstance(parsed, list) and parsed:
            return parsed
    except json.JSONDecodeError:
        pass
    return [{"screen": 0, "width": 1920, "height": 1080, "vertical": False, "plugin": ""}]


def target_monitor(screens: list[dict[str, object]] | None = None) -> str:
    val = str(load_state().get("monitor", "all"))
    if screens is None:
        screens = query_screens()
    valid_ids = {str(int(s["screen"])) for s in screens}
    if len(screens) <= 1:
        return next(iter(valid_ids), "0")
    if val == "all" or val in valid_ids:
        return val
    return "all"


def target_screens(screens: list[dict[str, object]], target: str) -> list[dict[str, object]]:
    if target != "all":
        matched = [s for s in screens if str(int(s["screen"])) == target]
        if matched:
            return matched
    return screens


def rgb_csv_to_hex(csv_val: str, fallback: str) -> str:
    parts = [p.strip() for p in csv_val.split(",")]
    if len(parts) >= 3 and all(p.isdigit() for p in parts[:3]):
        r, g, b = (max(0, min(255, int(p))) for p in parts[:3])
        return f"#{r:02x}{g:02x}{b:02x}"
    return fallback


def detect_status() -> dict[str, object]:
    state = load_state()
    scheme = kread("kdeglobals", "General", "ColorScheme", "BigDataDeskEthereal")
    theme_slug = next(
        (
            k
            for k, v in THEMES.items()
            if v["scheme"] == scheme
            or v["scheme"].replace("BigDataDesk", "GlassDesk") == scheme
            or v["scheme"].replace("BigDataDesk", "Omarchy") == scheme
        ),
        str(state.get("theme", "ethereal")),
    )

    default_accent = THEMES.get(theme_slug, {}).get("accent", "#7d82d9")
    accent_csv = kread("kdeglobals", "General", "AccentColor", "")
    accent_hex = rgb_csv_to_hex(accent_csv, str(state.get("accent", default_accent)))

    apps_active = max(40, min(100, int(kread("kwinrulesrc", "bigdatadesk-kde-apps", "opacityactive", "90"))))
    blur_strength = max(1, min(15, int(kread("kwinrc", "Effect-better-blur-dx", "BlurStrength", "14"))))
    cur_wm = kread("kwinrulesrc", "bigdatadesk-kde-apps", "wmclass", KDE_GLASS_WMCLASS_BASE)
    protect_text = bool(state.get("protect_text", "org.kde.kate" not in cur_wm and r"org\.kde\.kate" not in cur_wm))
    ui_opacity = apps_active
    icons = kread("kdeglobals", "Icons", "Theme", "Neonyt-Dark-Icons")
    transparency_mode = "reading" if ui_opacity >= 100 else "glass"

    screens = query_screens()
    monitor = target_monitor(screens)
    screen_check = int(monitor) if monitor != "all" else int(screens[0]["screen"])
    ref_screen = next((s for s in screens if int(s["screen"]) == screen_check), screens[0])
    wallpaper_mode = "video" if "smart.video.wallpaper" in str(ref_screen.get("plugin", "")) else "static"

    cur_key = f"last_{wallpaper_mode}_{screen_check}"
    cur_val = str(state.get(cur_key, state.get(f"last_{wallpaper_mode}", "")))

    rot_vid_on = bool(state.get("rotate_video_enabled", False))
    rot_vid_min = int(state.get("rotate_video_minutes", 5))
    rot_stat_on = bool(state.get("rotate_static_enabled", False))
    rot_stat_min = int(state.get("rotate_static_minutes", 5))

    return {
        "theme": theme_slug,
        "accent": accent_hex,
        "icons": icons,
        "transparency": transparency_mode,
        "opacity": ui_opacity,
        "blur": blur_strength,
        "protect_text": protect_text,
        "wallpaper": wallpaper_mode,
        "monitor": monitor,
        "screen_count": len(screens),
        "screens": screens,
        "current_file": os.path.basename(urllib.parse.unquote(cur_val)),
        "rotate_enabled": rot_vid_on if wallpaper_mode == "video" else rot_stat_on,
        "rotate_minutes": rot_vid_min if wallpaper_mode == "video" else rot_stat_min,
        "rotate_video_enabled": rot_vid_on,
        "rotate_video_minutes": rot_vid_min,
        "rotate_static_enabled": rot_stat_on,
        "rotate_static_minutes": rot_stat_min,
    }


def sync_konsole_from_palette(pal_name: str, opacity: float | None = None) -> None:
    if not os.path.exists(KONSOLE_SCHEME):
        return
    pal_path = os.path.join(PALETTE_DIR, f"{pal_name}.palette")
    colors: dict[str, str] = {}
    if os.path.exists(pal_path):
        with open(pal_path, "r", encoding="utf-8") as f:
            for line in f:
                if "=" in line:
                    k, v = line.strip().split("=", 1)
                    if v.startswith("#") and len(v) == 7:
                        colors[k] = f"{int(v[1:3], 16)},{int(v[3:5], 16)},{int(v[5:7], 16)}"

    with open(KONSOLE_SCHEME, "r", encoding="utf-8") as f:
        txt = f.read()

    if "Background" in colors:
        txt = re.sub(r"(\[Background\]\nColor=).*", rf"\g<1>{colors['Background']}", txt)
        txt = re.sub(r"(\[BackgroundFaint\]\nColor=).*", rf"\g<1>{colors['Background']}", txt)
    if "Foreground" in colors:
        txt = re.sub(r"(\[Foreground\]\nColor=).*", rf"\g<1>{colors['Foreground']}", txt)
        txt = re.sub(r"(\[ForegroundIntense\]\nColor=).*", rf"\g<1>{colors['Foreground']}", txt)
    for idx in range(8):
        norm_key = f"Color{idx}"
        bright_key = f"Color{idx + 8}"
        if norm_key in colors:
            txt = re.sub(rf"(\[Color{idx}\]\nColor=).*", rf"\g<1>{colors[norm_key]}", txt)
            txt = re.sub(rf"(\[Color{idx}Faint\]\nColor=).*", rf"\g<1>{colors[norm_key]}", txt)
        if bright_key in colors:
            txt = re.sub(rf"(\[Color{idx}Intense\]\nColor=).*", rf"\g<1>{colors[bright_key]}", txt)
    if opacity is not None:
        txt = re.sub(r"^Opacity=.*$", f"Opacity={opacity:.2f}", txt, flags=re.MULTILINE)

    with open(KONSOLE_SCHEME, "w", encoding="utf-8") as f:
        f.write(txt)


def apply_theme(slug: str) -> None:
    if slug not in THEMES:
        raise SystemExit(f"Unknown theme: {slug}")
    cfg = THEMES[slug]
    run(["plasma-apply-colorscheme", cfg["scheme"]])
    run(["plasma-apply-colorscheme", "--accent-color", cfg["accent"]])

    schema = ptyxis_profile_schema()
    if schema:
        run(["gsettings", "set", schema, "palette", cfg["ptyxis"]])

    sync_konsole_from_palette(cfg["ptyxis"])
    save_state({"theme": slug, "accent": cfg["accent"]})


def apply_accent(hex_color: str) -> None:
    hex_color = hex_color.strip()
    if not re.fullmatch(r"#[0-9a-fA-F]{6}", hex_color):
        raise SystemExit(f"Invalid hex color: {hex_color}")
    hex_color = hex_color.lower()

    run(["plasma-apply-colorscheme", "--accent-color", hex_color])

    schema = ptyxis_profile_schema()
    if schema:
        pal_name = run(["gsettings", "get", schema, "palette"]).strip("'")
        pal_path = os.path.join(PALETTE_DIR, f"{pal_name}.palette")
        if os.path.exists(pal_path):
            with open(pal_path, "r", encoding="utf-8") as f:
                content = f.read()
            new_content = re.sub(r"^Cursor=.*$", f"Cursor={hex_color.upper()}", content, flags=re.MULTILINE)
            with open(pal_path, "w", encoding="utf-8") as f:
                f.write(new_content)
            run(["gsettings", "set", schema, "palette", pal_name])

    save_state({"accent": hex_color})


def apply_icons(theme_name: str) -> None:
    tool = changeicons_bin()
    if tool:
        run([tool, theme_name])
    else:
        kwrite("kdeglobals", "Icons", "Theme", theme_name)
    save_state({"icons": theme_name})


def ensure_kwin_rule_entry(active_pct: int, inactive_pct: int, protect_text: bool = True) -> None:
    """Register or update bigdatadesk-kde-apps inside ~/.config/kwinrulesrc without duplicates."""
    existing_raw = kread("kwinrulesrc", "General", "Order", "") or kread("kwinrulesrc", "General", "rules", "")
    rules: list[str] = []
    for r in existing_raw.split(","):
        r = r.strip()
        if r and r not in rules:
            rules.append(r)
    if "bigdatadesk-kde-apps" not in rules:
        rules.append("bigdatadesk-kde-apps")
    joined = ",".join(rules)
    kwrite("kwinrulesrc", "General", "count", str(len(rules)))
    kwrite("kwinrulesrc", "General", "rules", joined)
    kwrite("kwinrulesrc", "General", "Order", joined)

    wm_pattern = KDE_GLASS_WMCLASS_BASE if protect_text else KDE_GLASS_WMCLASS_ALL
    kwrite("kwinrulesrc", "bigdatadesk-kde-apps", "Description", "BigDataDesk - Aplicaciones nativas de KDE")
    kwrite("kwinrulesrc", "bigdatadesk-kde-apps", "opacityactive", str(active_pct))
    kwrite("kwinrulesrc", "bigdatadesk-kde-apps", "opacityactiverule", "2")
    kwrite("kwinrulesrc", "bigdatadesk-kde-apps", "opacityinactive", str(inactive_pct))
    kwrite("kwinrulesrc", "bigdatadesk-kde-apps", "opacityinactiverule", "2")
    kwrite("kwinrulesrc", "bigdatadesk-kde-apps", "wmclass", wm_pattern)
    kwrite("kwinrulesrc", "bigdatadesk-kde-apps", "wmclasscomplete", "false")
    kwrite("kwinrulesrc", "bigdatadesk-kde-apps", "wmclassmatch", "3")


def apply_opacity(pct: int) -> None:
    """Apply custom opacity percentage (40..100) across KDE rules, Darkly, Ptyxis, and Konsole."""
    pct = max(40, min(100, pct))
    state = load_state()
    cur_wm = kread("kwinrulesrc", "bigdatadesk-kde-apps", "wmclass", KDE_GLASS_WMCLASS_BASE)
    protect_text = bool(state.get("protect_text", "org.kde.kate" not in cur_wm and r"org\.kde\.kate" not in cur_wm))

    if pct >= 100:
        p = dict(TRANSPARENCY_PROFILES["reading"])
        mode = "reading"
    elif pct == 90:
        p = dict(TRANSPARENCY_PROFILES["glass"])
        mode = "glass"
    else:
        p = {
            "ptyxis_opacity": round(max(0.35, min(0.99, pct * 0.82 / 90.0)), 2),
            "kde_active": pct,
            "kde_inactive": max(35, pct - 6),
            "dolphin_view": max(30, min(99, round(pct * 72 / 90.0))),
            "dolphin_sidebar": max(25, min(98, round(pct * 56 / 90.0))),
            "menus": max(35, min(99, round(pct * 74 / 90.0))),
            "bars": max(30, min(98, round(pct * 62 / 90.0))),
        }
        mode = "glass"

    schema = ptyxis_profile_schema()
    if schema:
        run(["gsettings", "set", schema, "opacity", str(p["ptyxis_opacity"])])

    ensure_kwin_rule_entry(int(p["kde_active"]), int(p["kde_inactive"]), protect_text=protect_text)

    for key, val in (
        ("DolphinViewOpacity", p["dolphin_view"]),
        ("DolphinSidebarOpacity", p["dolphin_sidebar"]),
        ("MenuOpacity", p["menus"]),
        ("MenuBarOpacity", p["bars"]),
        ("ToolBarOpacity", p["bars"]),
        ("TabBarOpacity", p["bars"]),
    ):
        kwrite("darklyrc", "Common", key, str(val))

    sync_konsole_from_palette("", opacity=float(p["ptyxis_opacity"]))
    run(["dbus-send", "--type=signal", "/DarklyStyle", "org.kde.Darkly.Style.reparseConfiguration"])
    run([qdbus_bin(), "org.kde.KWin", "/KWin", "org.kde.KWin.reconfigure"])
    save_state({"transparency": mode, "opacity": pct, "protect_text": protect_text})


def apply_protect_text(enabled: bool) -> None:
    """Keep document/code readers (Kate, Okular) opaque while keeping terminals & Dolphin glassy."""
    state = save_state({"protect_text": enabled})
    ensure_better_blur_defaults(protect_text=enabled)
    run([qdbus_bin(), "org.kde.KWin", "/Effects", "org.kde.kwin.Effects.reconfigureEffect", "better_blur_dx"])
    cur_opacity = int(state.get("opacity", 90))
    apply_opacity(cur_opacity)


BLUR_CLASSES_BASE = (
    "org.gnome.Ptyxis\nptyxis\n/.*[Pp]tyxis.*/\n"
    "org.kde.dolphin\ndolphin\n"
    "org.kde.konsole\nkonsole\n"
    "systemsettings\norg.kde.systemsettings\n"
    "org.kde.ark\norg.kde.kcalc\norg.kde.spectacle"
)
BLUR_CLASSES_ALL = BLUR_CLASSES_BASE + "\norg.kde.kate\nkate\norg.kde.okular\nokular"


def ensure_better_blur_defaults(protect_text: bool = True) -> None:
    """Ensure Better Blur DX static rules and contrast settings exist in kwinrc."""
    kwrite("kwinrc", "Plugins", "better_blur_dxEnabled", "true")
    kwrite("kwinrc", "Plugins", "blurEnabled", "false")
    kwrite("kwinrc", "Effect-better-blur-dx", "BlurDecorations", "true")
    kwrite("kwinrc", "Effect-better-blur-dx", "BlurDocks", "true")
    kwrite("kwinrc", "Effect-better-blur-dx", "BlurMenus", "true")
    kwrite("kwinrc", "Effect-better-blur-dx", "BlurMatching", "true")
    kwrite("kwinrc", "Effect-better-blur-dx", "BlurNonMatching", "false")
    kwrite("kwinrc", "Effect-better-blur-dx", "WindowClasses", BLUR_CLASSES_BASE if protect_text else BLUR_CLASSES_ALL)
    kwrite("kwinrc", "Effect-better-blur-dx", "CornerRadius", "8")
    kwrite("kwinrc", "Effect-better-blur-dx", "ForceContrastParams", "true")
    kwrite("kwinrc", "Effect-better-blur-dx", "Brightness", "82")
    kwrite("kwinrc", "Effect-better-blur-dx", "Contrast", "65")
    kwrite("kwinrc", "Effect-better-blur-dx", "Saturation", "115")


def apply_blur(strength: int) -> None:
    """Apply KWin Better Blur DX blur strength (1..15) + frosted grain and reload."""
    strength = max(1, min(15, strength))
    noise = 4 if strength >= 13 else (3 if strength >= 9 else 2)
    cur_wc = kread("kwinrc", "Effect-better-blur-dx", "WindowClasses", "")
    if "org.kde.dolphin" not in cur_wc:
        state = load_state()
        ensure_better_blur_defaults(protect_text=bool(state.get("protect_text", True)))
    kwrite("kwinrc", "Effect-better-blur-dx", "BlurStrength", str(strength))
    kwrite("kwinrc", "Effect-better-blur-dx", "NoiseStrength", str(noise))
    run([qdbus_bin(), "org.kde.KWin", "/Effects", "org.kde.kwin.Effects.reconfigureEffect", "better_blur_dx"])
    save_state({"blur": strength})


def apply_transparency(mode: str) -> None:
    if mode not in TRANSPARENCY_PROFILES:
        raise SystemExit(f"Unknown transparency mode: {mode}")
    apply_opacity(100 if mode == "reading" else 90)


def apply_reset_visuals() -> None:
    """Restore default crystal opacity (90%), blur strength (14), and Kate/Okular text protection."""
    kwrite("kwinrc", "Plugins", "diminactiveEnabled", "false")
    run([qdbus_bin(), "org.kde.KWin", "/Effects", "org.kde.kwin.Effects.unloadEffect", "diminactive"])
    ensure_better_blur_defaults()
    apply_blur(14)
    save_state({"protect_text": True, "opacity": 90})
    apply_opacity(90)


def resolve_video_pool(is_vertical: bool) -> tuple[list[str], int, bool]:
    """Return (video_uris, fill_mode, fill_blur) based on monitor orientation and Vertical/ contents."""
    if is_vertical:
        vert = list_videos(vertical=True)
        if vert:
            return ["file://" + urllib.parse.quote(v) for v in vert], 2, False
        horiz = list_videos(vertical=False)
        return ["file://" + urllib.parse.quote(v) for v in horiz], 1, True
    horiz = list_videos(vertical=False)
    return ["file://" + urllib.parse.quote(v) for v in horiz], 2, False


def resolve_static_pool(is_vertical: bool) -> tuple[list[str], int, bool]:
    """Return (image_paths, fill_mode, blur_bg) based on monitor orientation and Vertical/ contents."""
    if is_vertical:
        vert = list_static_wallpapers(vertical=True)
        if vert:
            return vert, 2, False
        return list_static_wallpapers(vertical=False), 1, True
    return list_static_wallpapers(vertical=False), 2, False


def apply_video_for_screen(
    screen_id: int,
    video_uri: str,
    pool_uris: list[str],
    fill_mode: int,
    fill_blur: bool,
    rotate_enabled: bool = False,
    rotate_minutes: int = 5,
) -> None:
    target_list = pool_uris if rotate_enabled else [video_uri]
    entries = [
        {
            "filename": u,
            "enabled": True,
            "duration": 0,
            "customDuration": 0,
            "playbackRate": 0.0,
            "alternativePlaybackRate": 0.0,
            "loop": not rotate_enabled,
        }
        for u in target_list
    ]
    video_urls_json = json.dumps(entries)
    change_mode = 2 if rotate_enabled else 0
    timer_min = max(1, rotate_minutes) if rotate_enabled else 0
    random_js = "true" if rotate_enabled else "false"
    crossfade_js = "true" if rotate_enabled else "false"

    js = f"""
var ds = desktops();
var videoUrls = {json.dumps(video_urls_json)};
for (var i = 0; i < ds.length; i++) {{
    if (ds[i].screen !== {screen_id}) continue;
    var d = ds[i];
    d.wallpaperPlugin = "luisbocanegra.smart.video.wallpaper.reborn";
    d.currentConfigGroup = ["Wallpaper", "luisbocanegra.smart.video.wallpaper.reborn", "General"];
    d.writeConfig("VideoUrls", videoUrls);
    d.writeConfig("ChangeWallpaperMode", {change_mode});
    d.writeConfig("ChangeWallpaperTimerMinutes", {timer_min});
    d.writeConfig("ChangeWallpaperTimerSeconds", 0);
    d.writeConfig("ChangeWallpaperTimerHours", 0);
    d.writeConfig("RandomMode", {random_js});
    d.writeConfig("CrossfadeEnabled", {crossfade_js});
    d.writeConfig("CrossfadeDuration", 1000);
    d.writeConfig("PauseMode", 0);
    d.writeConfig("MuteMode", 5);
    d.writeConfig("BlurMode", 5);
    d.writeConfig("FillMode", {fill_mode});
    d.writeConfig("FillBlur", {"true" if fill_blur else "false"});
    d.writeConfig("FillBlurRadius", 64);
    d.writeConfig("LastVideoPosition", 0);
    d.writeConfig("ResumeLastVideo", false);
    d.writeConfig("LastVideo", {json.dumps(video_uri)});
}}
"""
    run([qdbus_bin(), "org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell.evaluateScript", js])


def apply_static_for_screen(
    screen_id: int,
    image_path: str,
    fill_mode: int,
    blur_bg: bool,
    rotate_enabled: bool = False,
    rotate_minutes: int = 5,
    is_vertical: bool = False,
) -> None:
    if rotate_enabled:
        if is_vertical and list_static_wallpapers(vertical=True):
            slide_paths = [STATIC_VERT_DIR]
        else:
            slide_paths = sorted(
                d for d in glob.glob(os.path.join(STATIC_DIR, "*"))
                if os.path.isdir(d) and os.path.basename(d) != "Vertical"
            ) or [STATIC_DIR]
        interval_sec = max(1, rotate_minutes) * 60
        js = f"""
var ds = desktops();
for (var i = 0; i < ds.length; i++) {{
    if (ds[i].screen !== {screen_id}) continue;
    var d = ds[i];
    d.wallpaperPlugin = "org.kde.slideshow";
    d.currentConfigGroup = ["Wallpaper", "org.kde.slideshow", "General"];
    d.writeConfig("SlidePaths", {json.dumps(slide_paths)});
    d.writeConfig("SlideInterval", {interval_sec});
    d.writeConfig("SlideshowMode", 0);
    d.writeConfig("FillMode", {fill_mode});
    d.writeConfig("Blur", {"true" if blur_bg else "false"});
}}
"""
    else:
        uri = "file://" + urllib.parse.quote(image_path)
        js = f"""
var ds = desktops();
for (var i = 0; i < ds.length; i++) {{
    if (ds[i].screen !== {screen_id}) continue;
    var d = ds[i];
    d.wallpaperPlugin = "org.kde.image";
    d.currentConfigGroup = ["Wallpaper", "org.kde.image", "General"];
    d.writeConfig("Image", {json.dumps(uri)});
    d.writeConfig("FillMode", {fill_mode});
    d.writeConfig("Blur", {"true" if blur_bg else "false"});
}}
"""
    run([qdbus_bin(), "org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell.evaluateScript", js])


def set_video_wallpaper(target: str | None = None, delta: int = 0) -> None:
    screens_all = query_screens()
    target = target or target_monitor(screens_all)
    screens = target_screens(screens_all, target)
    state = load_state()
    rot_on = bool(state.get("rotate_video_enabled", False))
    rot_min = int(state.get("rotate_video_minutes", 5))
    updates: dict[str, object] = {"wallpaper": "video"}

    for sc in screens:
        sid = int(sc["screen"])
        is_vert = bool(sc["vertical"])
        uris, fill_mode, fill_blur = resolve_video_pool(is_vert)
        if not uris:
            raise SystemExit(f"No videos found in {VIDEO_DIR}")

        key = f"last_video_{sid}"
        current = str(state.get(key, state.get("last_video", "")))
        if current in uris:
            idx = (uris.index(current) + delta) % len(uris)
        else:
            idx = 0 if delta >= 0 else len(uris) - 1

        chosen = uris[idx]
        apply_video_for_screen(sid, chosen, uris, fill_mode, fill_blur, rot_on, rot_min)
        updates[key] = chosen
        updates["last_video"] = chosen

    save_state(updates)


def set_static_wallpaper(target: str | None = None, delta: int = 0) -> None:
    screens_all = query_screens()
    target = target or target_monitor(screens_all)
    screens = target_screens(screens_all, target)
    state = load_state()
    rot_on = bool(state.get("rotate_static_enabled", False))
    rot_min = int(state.get("rotate_static_minutes", 5))
    theme = str(detect_status()["theme"])
    subdir = THEMES.get(theme, {}).get("wallpaper_subdir", "tokyo-night")
    updates: dict[str, object] = {"wallpaper": "static"}

    for sc in screens:
        sid = int(sc["screen"])
        is_vert = bool(sc["vertical"])
        images, fill_mode, blur_bg = resolve_static_pool(is_vert)
        if not images:
            raise SystemExit(f"No static wallpapers found in {STATIC_DIR}")

        key = f"last_static_{sid}"
        current = str(state.get(key, state.get("last_static", "")))
        if current in images:
            idx = (images.index(current) + delta) % len(images)
        else:
            themed = [i for i, p in enumerate(images) if f"/{subdir}/" in p]
            idx = themed[0] if themed else 0

        chosen = images[idx]
        apply_static_for_screen(sid, chosen, fill_mode, blur_bg, rot_on, rot_min, is_vert)
        updates[key] = chosen
        updates["last_static"] = chosen

    save_state(updates)


def set_rotation(enabled: bool, minutes: int | None = None) -> None:
    status = detect_status()
    mode = str(status["wallpaper"])
    prefix = "rotate_video" if mode == "video" else "rotate_static"
    updates: dict[str, object] = {f"{prefix}_enabled": enabled}
    if minutes is not None:
        updates[f"{prefix}_minutes"] = max(1, min(1440, minutes))
    save_state(updates)
    if mode == "video":
        set_video_wallpaper(delta=0)
    else:
        set_static_wallpaper(delta=0)


def step_wallpaper(delta: int) -> None:
    status = detect_status()
    if status["wallpaper"] == "video":
        set_video_wallpaper(delta=delta)
    else:
        set_static_wallpaper(delta=delta)


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        print("Usage: bigdatadesk <status|theme|accent|icons|transparency|opacity|blur|protect-text|reset|monitor|wallpaper|rotation>", file=sys.stderr)
        return 1

    cmd = argv[1]
    arg = argv[2] if len(argv) > 2 else ""

    if cmd == "status":
        print(json.dumps(detect_status()))
    elif cmd == "theme":
        apply_theme(arg)
    elif cmd == "accent":
        apply_accent(arg)
    elif cmd == "icons":
        apply_icons(arg)
    elif cmd == "transparency":
        apply_transparency(arg)
    elif cmd == "opacity":
        apply_opacity(int(arg))
    elif cmd == "blur":
        apply_blur(int(arg))
    elif cmd == "protect-text":
        if arg not in ("on", "off"):
            raise SystemExit(f"Unknown protect-text flag: {arg}")
        apply_protect_text(arg == "on")
    elif cmd == "reset":
        apply_reset_visuals()
    elif cmd == "monitor":
        if arg != "all" and not arg.isdigit():
            raise SystemExit(f"Unknown monitor target: {arg}")
        save_state({"monitor": arg})
    elif cmd == "rotation":
        if arg not in ("on", "off"):
            raise SystemExit(f"Unknown rotation flag: {arg}")
        mins = int(argv[3]) if len(argv) > 3 else None
        set_rotation(arg == "on", mins)
    elif cmd == "wallpaper":
        if arg == "video":
            set_video_wallpaper(delta=0)
        elif arg == "static":
            set_static_wallpaper(delta=0)
        elif arg == "next":
            step_wallpaper(1)
        elif arg == "prev":
            step_wallpaper(-1)
        else:
            raise SystemExit(f"Unknown wallpaper action: {arg}")
    else:
        raise SystemExit(f"Unknown command: {cmd}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
