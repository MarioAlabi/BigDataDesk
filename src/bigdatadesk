def qdbus_bin() -> str:
    return (
        shutil.which("qdbus-qt6")
        or shutil.which("qdbus6")
        or shutil.which("qdbus")
        or "qdbus6"
    )


def changeicons_bin() -> str | None:
    found = shutil.which("plasma-changeicons")
    if found:
        return found
    for path in (
        "/usr/libexec/plasma-changeicons",
        "/usr/lib/plasma-changeicons",
        "/usr/lib/kf6/plasma-changeicons",
        "/usr/lib/x86_64-linux-gnu/libexec/plasma-changeicons",
    ):
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    return None


def run(cmd: list[str]) -> str:
    try:
        res = subprocess.run(cmd, capture_output=True, text=True)
    except OSError as exc:
        print(f"Command failed ({cmd[0]}): {exc}", file=sys.stderr)
        return ""
    if res.returncode != 0 and res.stderr:
        print(res.stderr.strip(), file=sys.stderr)
    return res.stdout.strip()


def kread(file_name: str, group: str, key: str, default: str = "") -> str:
    val = run(["kreadconfig6", "--file", file_name, "--group", group, "--key", key])
    return val if val else default


def kwrite(file_name: str, group: str, key: str, value: str) -> None:
    run(["kwriteconfig6", "--file", file_name, "--group", group, "--key", key, value])


def load_state() -> dict[str, object]:
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
            if isinstance(data, dict):
                return data
    except (FileNotFoundError, json.JSONDecodeError):
        pass
    return {}


def save_state(updates: dict[str, object]) -> dict[str, object]:
    state = load_state()
    state.update(updates)
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    with open(STATE_FILE, "w", encoding="utf-8") as f:
        json.dump(state, f, indent=2)
    return state


def ptyxis_profile_schema() -> str | None:
    if not shutil.which("gsettings"):
        return None
    uuid = run(["gsettings", "get", "org.gnome.Ptyxis", "default-profile-uuid"]).strip("'")
    if not uuid or uuid.startswith("No such schema"):
        return None
    return f"org.gnome.Ptyxis.Profile:/org/gnome/Ptyxis/Profiles/{uuid}/"


VIDEO_EXTENSIONS = (
    ".mp4", ".mov", ".m4v", ".mkv", ".webm", ".avi",
    ".ts", ".m2ts", ".mts", ".flv", ".wmv", ".mpg", ".mpeg", ".ogv", ".3gp", ".vob",
)
